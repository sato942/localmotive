{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sato942/localmotive/blob/main/release-evidence/qualification-attestation.schema.json",
  "title": "Localmotive L4 product qualification attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "p0Id", "release", "sourceRevision", "artifactDigest", "modelDigest", "qualificationKey", "evidenceLevel", "result", "executedAt", "expiryIdentity", "verifier", "evidence", "limitations", "approver"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "p0Id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "release": { "const": "0.4.1" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "modelDigest": { "const": "sha256:e3131339bf4e8065265593d4fd8f7bb7ff2d3abff1edb5618aa1197b89cad9f5" },
    "qualificationKey": { "$ref": "#/$defs/qualificationKey" },
    "evidenceLevel": { "const": "L4_PRODUCT" },
    "result": { "enum": ["PASS", "FAIL"] },
    "executedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "expiryIdentity": { "type": "string", "pattern": "^compatibility-v1:sha256:[0-9a-f]{64}$" },
    "verifier": { "type": "string", "minLength": 1, "maxLength": 160 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^release-evidence/0\\.4\\.1/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "limitations": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "approver": { "type": "string", "minLength": 1, "maxLength": 160 }
  },
  "$defs": {
    "qualificationKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osBuild", "architecture", "adapterId", "driver", "firmware", "backend", "installKey", "releaseCommit", "assetName", "assetSha256"],
      "properties": {
        "osBuild": { "type": "string", "minLength": 1, "maxLength": 80 },
        "architecture": { "const": "x64" },
        "adapterId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "driver": { "type": "string", "minLength": 1, "maxLength": 160 },
        "firmware": { "type": "string", "minLength": 1, "maxLength": 160 },
        "backend": { "type": "string", "minLength": 1, "maxLength": 80 },
        "installKey": { "type": "string", "minLength": 1, "maxLength": 160 },
        "releaseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "assetName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "assetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
