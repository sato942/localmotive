{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sato942/localmotive/blob/main/release-evidence/qualification-matrix.schema.json",
  "title": "Localmotive P0 qualification matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "sourceRevision", "riskDecision", "rows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "const": "0.4.1" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "riskDecision": { "const": "missing-p0-hardware-evidence" },
    "rows": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hardwareClass", "os", "architecture", "backend", "status", "supportClaim", "evidenceLevel", "evidenceSummary", "releaseNotesDisclosed", "attestation"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 96 },
          "hardwareClass": { "type": "string", "minLength": 1, "maxLength": 160 },
          "os": { "type": "string", "minLength": 1, "maxLength": 80 },
          "architecture": { "const": "x64" },
          "backend": { "type": "string", "minLength": 1, "maxLength": 80 },
          "status": { "enum": ["L4_PASS", "L4_FAIL", "DIRECT_L2", "UPSTREAM_ONLY", "UPSTREAM_FAILURE", "UNKNOWN"] },
          "supportClaim": { "type": "boolean" },
          "evidenceLevel": { "enum": ["L4_PRODUCT", "L2_DIRECT_RUNTIME", "UPSTREAM", "NONE"] },
          "evidenceSummary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "releaseNotesDisclosed": { "type": "boolean" },
          "attestation": { "type": ["string", "null"], "maxLength": 160 }
        }
      }
    }
  }
}
