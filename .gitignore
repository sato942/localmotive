# Build artifacts
/dist
/src-tauri/target
*.tsbuildinfo
node_modules
/localmotive.exe

# D3: the tracked artifacts/ directory was removed from the tree. Runtime
# verification outputs stay untracked here and never ride into a commit.
# (The release stage uses $RUNNER_TEMP, not this directory.)
/artifacts/

# Python bytecode from the verification scripts
__pycache__/
*.pyc

# Local verification output (machine-specific screenshots and metrics)
/.impeccable/review
/.impeccable/detect.json

# Local research worktrees and notes
/research

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea
.vscode

# Secrets — never commit
.env
.env.*
*.key
*.pem
