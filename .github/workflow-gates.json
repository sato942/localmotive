{
  "schema": 1,
  "workflows": {
    "catalog.yml": {
      "gates": {
        "build": [
          "node scripts/verify_workflow_pins.mjs",
          "node scripts/verify_workflow_gates.mjs",
          "node scripts/build_catalog.mjs",
          "node scripts/validate_catalog.mjs catalog/catalog.json --no-signature"
        ],
        "sign": [
          "node scripts/sign_catalog_candidate.mjs",
          "node scripts/validate_catalog.mjs catalog/catalog.json"
        ]
      },
      "packageJobs": {},
      "publicationJobs": {}
    },
    "ci.yml": {
      "gates": {
        "check": [
          "node scripts/verify_versions.mjs",
          "node scripts/verify_workflow_pins.mjs",
          "node scripts/verify_workflow_gates.mjs",
          "node --test scripts/tests/release-gates.test.mjs",
          "npm run check",
          "npm audit --audit-level=moderate",
          "cargo fmt --check",
          "cargo clippy --locked --all-targets -- -D warnings",
          "cargo test --locked",
          "cargo test --locked --doc"
        ],
        "rust-audit": [],
        "pr-check": [
          "node scripts/verify_versions.mjs",
          "node scripts/verify_workflow_pins.mjs",
          "node scripts/verify_workflow_gates.mjs",
          "node --test scripts/tests/release-gates.test.mjs",
          "npm run check",
          "npm audit --audit-level=moderate",
          "cargo fmt --check",
          "cargo clippy --locked --all-targets -- -D warnings",
          "cargo test --locked -- --nocapture",
          "cargo test --locked --doc"
        ]
      },
      "packageJobs": {
        "package-smoke": [
          "check",
          "rust-audit"
        ]
      },
      "requiredCommands": {
        "package-smoke": [
          "npm run tauri build"
        ]
      },
      "publicationJobs": {}
    },
    "release.yml": {
      "gates": {
        "quality": [
          "node scripts/verify_versions.mjs ${{ needs.resolve.outputs.version }}",
          "node scripts/verify_workflow_pins.mjs",
          "node scripts/verify_workflow_gates.mjs",
          "node --test scripts/tests/release-gates.test.mjs",
          "npm run check",
          "npm audit --audit-level=moderate",
          "cargo fmt --check",
          "cargo clippy --locked --all-targets -- -D warnings",
          "cargo test --locked",
          "cargo test --locked --doc"
        ],
        "rust-audit": [],
        "resolve": [],
        "clean-account-lifecycle": [],
        "qualification": []
      },
      "packageJobs": {
        "package": [
          "quality",
          "rust-audit"
        ]
      },
      "requiredCommands": {
        "package": [
          "npm run tauri build",
          "pwsh -NoProfile -File scripts/verify_packaged_matrix.ps1 -Portable $portable -Version \"$env:VERSION\" -ResolvedSha \"$env:RESOLVED_SHA\" -CdpPort $cdpPort",
          "node scripts/verify_candidate_inventory.mjs artifacts \"$VERSION\" \"artifacts/candidate-inventory-${VERSION}.json\""
        ],
        "clean-account-lifecycle": [
          "& \".\\scripts\\sandbox\\host-run-lifecycle.ps1\" -Tag \"${{ needs.resolve.outputs.tag }}\" -Version \"${{ needs.quality.outputs.version }}\" -PreviousTag $leg.Previous -CandidateDir \"artifacts\" -EvidenceName $leg.Name -PreservationFlavor $leg.Flavor"
        ],
        "qualification": [
          "node scripts/build_qualification_manifest.mjs --inventory \"artifacts/candidate-inventory-${VERSION}.json\" --attestations \"release-evidence/${VERSION}/attestations\" --release \"$VERSION\" --stage-packaged-verification \"artifacts/packaged-verification-${VERSION}.json\" --out \"release-evidence/${VERSION}/qualification-manifest-${VERSION}.json\"",
          "node scripts/verify_qualification_manifest.mjs --expect-source \"$RESOLVED_SHA\"",
          "node scripts/verify_release_promotion.mjs --qualified . --tag \"v${VERSION}\" --expect-source \"$RESOLVED_SHA\" --report \"artifacts/promotion-check-${VERSION}.json\""
        ]
      },
      "publicationJobs": {},
      "forbiddenCommands": [
        "softprops/action-gh-release",
        "gh release create",
        "gh release upload",
        "contents: write"
      ]
    },
    "hardware-qualify.yml": {
      "gates": {
        "hardware-qualify": []
      },
      "packageJobs": {},
      "publicationJobs": {}
    },
    "release-promote.yml": {
      "gates": {
        "gate": []
      },
      "packageJobs": {},
      "requiredCommands": {
        "gate": [
          "node scripts/verify_qualification_manifest.mjs --expect-source \"$RESOLVED_SHA\"",
          "node scripts/verify_release_promotion.mjs --qualified . --tag \"v${VERSION}\" --expect-source \"$RESOLVED_SHA\" --verify-run \"$VERIFY_RUN_ID\" --report \"artifacts/promotion-check-${VERSION}.json\"",
          "(cd artifacts && sha256sum -c \"SHA256SUMS-${VERSION}.txt\")"
        ],
        "publish": [
          "node scripts/verify_release_promotion.mjs --qualified . --tag \"v${VERSION}\" --expect-source \"$RESOLVED_SHA\" --verify-run \"$VERIFY_RUN_ID\" --report \"artifacts/promotion-check-${VERSION}.json\"",
          "(cd artifacts && sha256sum -c \"SHA256SUMS-${VERSION}.txt\")",
          "LOCALMOTIVE_SOURCE_REVISION=\"$RESOLVED_SHA\" node scripts/verify_candidate_inventory.mjs --verify \"public-readback/candidate-inventory-${VERSION}.json\" \"$VERSION\""
        ]
      },
      "publicationJobs": {
        "publish": [
          "gate"
        ]
      }
    }
  }
}
