{
  "schema": 1,
  "workflows": {
    "catalog.yml": {
      "gates": {
        "build": [
          "node scripts/verify_workflow_pins.mjs",
          "node scripts/verify_workflow_gates.mjs",
          "node scripts/build_catalog.mjs",
          "node scripts/validate_catalog.mjs catalog/catalog.json --no-signature"
        ],
        "sign": [
          "node scripts/sign_catalog_candidate.mjs",
          "node scripts/validate_catalog.mjs catalog/catalog.json"
        ]
      },
      "packageJobs": {},
      "publicationJobs": {}
    },
    "ci.yml": {
      "gates": {
        "check": [
          "node scripts/verify_versions.mjs 0.5.0",
          "node scripts/verify_workflow_pins.mjs",
          "node scripts/verify_workflow_gates.mjs",
          "node --test scripts/tests/release-gates.test.mjs",
          "npm run check",
          "npm audit --audit-level=moderate",
          "cargo fmt --check",
          "cargo clippy --locked --all-targets -- -D warnings",
          "cargo test --locked",
          "cargo test --locked --doc"
        ],
        "rust-audit": [],
        "pr-check": [
          "node scripts/verify_versions.mjs 0.5.0",
          "node scripts/verify_workflow_pins.mjs",
          "node scripts/verify_workflow_gates.mjs",
          "node --test scripts/tests/release-gates.test.mjs",
          "npm run check",
          "npm audit --audit-level=moderate",
          "cargo fmt --check",
          "cargo clippy --locked --all-targets -- -D warnings",
          "cargo test --locked",
          "cargo test --locked --doc"
        ]
      },
      "packageJobs": {
        "package-smoke": [
          "check",
          "rust-audit"
        ]
      },
      "requiredCommands": {
        "package-smoke": [
          "npm run tauri build"
        ]
      },
      "publicationJobs": {}
    },
    "release.yml": {
      "gates": {
        "quality": [
          "node scripts/verify_versions.mjs 0.5.0",
          "node scripts/verify_workflow_pins.mjs",
          "node scripts/verify_workflow_gates.mjs",
          "node --test scripts/tests/release-gates.test.mjs",
          "npm run check",
          "npm audit --audit-level=moderate",
          "cargo fmt --check",
          "cargo clippy --locked --all-targets -- -D warnings",
          "cargo test --locked",
          "cargo test --locked --doc"
        ],
        "rust-audit": [],
        "resolve": [],
        "clean-account-lifecycle": []
      },
      "packageJobs": {
        "package": [
          "quality",
          "rust-audit"
        ]
      },
      "requiredCommands": {
        "package": [
          "npm run tauri build",
          "node scripts/verify_041.mjs $cdpPort $portable \"artifacts/packaged-verification-0.4.1.json\"",
          "node scripts/verify_candidate_inventory.mjs artifacts \"$VERSION\" \"artifacts/candidate-inventory-${VERSION}.json\"",
          "$catalogInit = (node scripts/verify_060_catalog.mjs init $catalogState \"artifacts/catalog-fixture-init.json\" | ConvertFrom-Json)",
          "node scripts/verify_060_catalog.mjs first-fill $cdpPort $catalogState \"artifacts/catalog-matrix-first-fill.json\"",
          "node scripts/verify_060_catalog.mjs prep $catalogState",
          "node scripts/verify_060_catalog.mjs restart $cdpPort $catalogState \"artifacts/catalog-matrix-restart.json\"",
          "node scripts/verify_060_catalog.mjs merge $portable \"artifacts/catalog-matrix-first-fill.json\" \"artifacts/catalog-matrix-restart.json\" \"artifacts/packaged-verification-catalog-$env:VERSION.json\""
        ],
        "publish": [
          "LOCALMOTIVE_SOURCE_REVISION=\"$RESOLVED_SHA\" node scripts/verify_candidate_inventory.mjs --verify \"artifacts/candidate-inventory-${VERSION}.json\"",
          "(cd artifacts && sha256sum -c \"SHA256SUMS-${VERSION}.txt\")"
        ],
        "clean-account-lifecycle": [
          "& \".\\scripts\\sandbox\\host-run-lifecycle.ps1\" -Tag \"${{ needs.resolve.outputs.tag }}\" -Version \"${{ needs.quality.outputs.version }}\" -PreviousTag \"$env:UPGRADE_BASELINE\" -CandidateDir \"artifacts\""
        ]
      },
      "publicationJobs": {
        "publish": [
          "quality",
          "rust-audit",
          "package"
        ]
      }
    },
    "hardware-qualify.yml": {
      "gates": {
        "hardware-qualify": []
      },
      "packageJobs": {},
      "publicationJobs": {}
    }
  }
}