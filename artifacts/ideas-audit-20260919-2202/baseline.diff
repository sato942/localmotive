-                if *weight == 0.0 {
-                    continue;
-                }
-                if let Some(value) = extract(candidate) {
-                    let (minimum, maximum) = ranges[slot];
-                    let normalized = normalized(value, minimum, maximum, *maximize);
-                    available_weight += *weight;
