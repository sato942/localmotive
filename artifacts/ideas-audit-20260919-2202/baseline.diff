-            id: candidate.id.clone(),
-            feasible,
-            violations: violations[index].clone(),
-            evidence_coverage,
-            dominators_truncated,
-            pareto: feasible && dominated_by.is_empty(),
-            dominated_by,
-            preference_score,
-            score_components,
